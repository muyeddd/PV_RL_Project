  "input_preprocessing": {
    "source": "raw irradiance parsed from selected model_development filenames",
    "dtype": "float32",
    "standardized": false,
    "clipped": false,
    "strict_unit_interval_assumed": false,
    "physical_unit": null
  },
  "note": "Frozen formal-CV irradiance-only baseline matched to date_grouped_v1 ResNet50 ablations."
